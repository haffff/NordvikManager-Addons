{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "categories": {
        "type": "array",
        "description": "Categories available to addons in this repository. Addons reference them by 'key' in their 'categories' field.",
        "items": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Unique, case sensitive category identifier.",
                    "pattern": "^[a-z0-9-]+$"
                },
                "name": {
                    "type": "string",
                    "description": "Display name of the category."
                },
                "description": {
                    "type": "string"
                }
            },
            "required": ["key", "name"]
        }
    },
    "repository": {
        "type": "array",
        "items": {
            "$ref": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/addon.json"
        }
    }
  }
}
